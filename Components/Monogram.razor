@* Botanical line-mark: "NM" initials with a small hand-drawn flower flourish. *@

<svg class="monogram" width="@Size" height="@Size" viewBox="0 0 64 64" fill="none"
     xmlns="http://www.w3.org/2000/svg" aria-hidden="true" role="img">

    <text x="4" y="46" font-family="'Fraunces', serif" font-size="30" font-weight="600" fill="var(--color-ink)">N</text>
    <text x="27" y="46" font-family="'Fraunces', serif" font-size="30" font-weight="600" fill="var(--color-primary-dark)">M</text>

    <g stroke="var(--color-primary)" stroke-width="1.3" stroke-linecap="round" fill="none">

        <path d="M50 20 C 46 22, 42 25, 38 28" />

        <g transform="translate(50 13)">
            <ellipse cx="0" cy="-4.5" rx="2.1" ry="3.6" />
            <ellipse cx="0" cy="-4.5" rx="2.1" ry="3.6" transform="rotate(72)" />
            <ellipse cx="0" cy="-4.5" rx="2.1" ry="3.6" transform="rotate(144)" />
            <ellipse cx="0" cy="-4.5" rx="2.1" ry="3.6" transform="rotate(216)" />
            <ellipse cx="0" cy="-4.5" rx="2.1" ry="3.6" transform="rotate(288)" />
        </g>

        <circle cx="50" cy="13" r="1.4" fill="var(--color-accent)" stroke="none" />

    </g>

</svg>

@code {

    [Parameter]
    public string Size { get; set; } = "40";

}
